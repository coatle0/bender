# ===========================================
# Bender - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# -------------------------------------------
# Required: Slack
# -------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# -------------------------------------------
# Required: Claude Code authentication
# Provide at least one of the following:
# -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-api-key
# CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token

# -------------------------------------------
# Optional: Bender settings
# -------------------------------------------
BENDER_WORKSPACE=/workspace
BENDER_API_PORT=8080
BENDER_DB_PATH=/workspace/bender_sessions.sqlite3
BENDER_API_KEY=your-secret-api-key
# Max brand-new-thread subprocess cold starts allowed to run at once; a
# burst of unrelated @mentions won't fight each other for CPU/network/MCP
# session state during their MCP handshake. Doesn't limit already-live
# threads, which keep running fully in parallel.
BENDER_MAX_CONCURRENT_STARTS=2
LOG_LEVEL=info
